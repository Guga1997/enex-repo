# /var/www/enex/.env — პროდაქშენი
# ეს ფაილი git-ში არ ხვდება. უფლებები: chmod 600, მფლობელი enex.

DATABASE_URL="postgresql://enex:ᲨᲔᲪᲕᲐᲚᲔ@localhost:5432/enex?schema=public"

# openssl rand -base64 48
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="https://enex.ge"

# --- ინვოისის რეკვიზიტები ---
SELLER_NAME=""
SELLER_TAX_ID=""
SELLER_ADDRESS=""
SELLER_PHONE=""
SELLER_EMAIL=""
SELLER_BANK_NAME=""
SELLER_BANK_CODE=""
SELLER_IBAN=""

# --- შეტყობინებები გაყიდვებს ---
# ყოველ ახალ შეკვეთაზე და გადახდაზე — რამდენიმე მისამართი მძიმით. ცარიელი = არ იგზავნება.
SALES_EMAIL=""
# არასავალდებულო: მოკლე SMS ყოველ ახალ შეკვეთაზე (ფასიანია)
SALES_PHONE=""

# --- ელფოსტა: Hetzner Webhosting SMTP ---
# ყუთი konsoleH-ში იქმნება (enex.ge → Email → Mailboxes). SPF/DKIM Hetzner DNS-ში უკვე დგას.
SMTP_HOST="mail.your-server.de"
SMTP_PORT="587"
SMTP_USER="noreply@enex.ge"
SMTP_PASS=""
MAIL_FROM="Enex <noreply@enex.ge>"
# Resend — მხოლოდ SMTP-ის გარეშე
RESEND_API_KEY=""

# --- SMS ---
# brevo (ნაგულისხმევი) | ubill | smsoffice. Brevo-ს SMS-ს ცალკე API გასაღები სჭირდება, არა SMTP-ის.
SMS_PROVIDER="brevo"
SMS_API_KEY=""
SMS_SENDER="Enex"
# მხოლოდ uBill-ისთვის — Brand-ის ნომერი მათ პანელში
SMS_BRAND_ID=""

# --- საქართველოს ბანკი ---
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_PUBLIC_KEY=""
# 0 = ნამდვილი გადახდა. ხელმოწერის საჯარო გასაღების გარეშე callback უარიყოფა.
PAYMENT_MOCK="0"
