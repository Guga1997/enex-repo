# /var/www/enex/.env — პროდაქშენი
# ეს ფაილი git-ში არ ხვდება. უფლებები: chmod 600, მფლობელი enex.

DATABASE_URL="postgresql://enex:ᲨᲔᲪᲕᲐᲚᲔ@localhost:5432/enex?schema=public"

# openssl rand -base64 48
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="https://enex.ge"

# --- ინვოისის რეკვიზიტები ---
SELLER_NAME=""
SELLER_TAX_ID=""
SELLER_ADDRESS=""
SELLER_PHONE=""
SELLER_EMAIL=""
SELLER_BANK_NAME=""
SELLER_BANK_CODE=""
SELLER_IBAN=""

# --- ელფოსტა ---
# SMTP (Brevo) უპირატესია: SMTP_HOST-ის არსებობისას ის იმუშავებს. Resend — მხოლოდ SMTP-ის გარეშე.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
# გამომგზავნი Brevo-ში დადასტურებული უნდა იყოს — ან მისამართი, ან მთელი დომენი (DKIM)
MAIL_FROM="Enex <noreply@enex.ge>"

# --- SMS (smsoffice.ge) ---
SMS_API_KEY=""
SMS_SENDER=""

# --- საქართველოს ბანკი ---
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_PUBLIC_KEY=""
# 0 = ნამდვილი გადახდა. ხელმოწერის საჯარო გასაღების გარეშე callback უარიყოფა.
PAYMENT_MOCK="0"
