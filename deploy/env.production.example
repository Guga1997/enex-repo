# /var/www/enex/.env — პროდაქშენი
# ეს ფაილი git-ში არ ხვდება. უფლებები: chmod 600, მფლობელი enex.

DATABASE_URL="postgresql://enex:ᲨᲔᲪᲕᲐᲚᲔ@localhost:5432/enex?schema=public"

# openssl rand -base64 48
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="https://enex.ge"

# --- ინვოისის რეკვიზიტები ---
SELLER_NAME=""
SELLER_TAX_ID=""
SELLER_ADDRESS=""
SELLER_PHONE=""
SELLER_EMAIL=""
SELLER_BANK_NAME=""
SELLER_BANK_CODE=""
SELLER_IBAN=""

# --- ელფოსტა (Resend) ---
RESEND_API_KEY=""
MAIL_FROM="noreply@enex.ge"

# --- SMS (smsoffice.ge) ---
SMS_API_KEY=""
SMS_SENDER=""

# --- საქართველოს ბანკი ---
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_PUBLIC_KEY=""
# 0 = ნამდვილი გადახდა. ხელმოწერის საჯარო გასაღების გარეშე callback უარიყოფა.
PAYMENT_MOCK="0"
