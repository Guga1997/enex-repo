px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>DWDR</p>\n</td>\n</tr>\n<tr style=\"height: 14px;\">\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>აუდიო შეკუმშვა&nbsp;</p>\n</td>\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>G.711</p>\n</td>\n</tr>\n<tr style=\"height: 14px;\">\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>ჩახშობის მხარდაჭერა</p>\n</td>\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>დიახ</p>\n</td>\n</tr>\n<tr style=\"height: 14px;\">\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>შერჩევის სიხშირე&nbsp;</p>\n</td>\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>8KHZ</p>\n</td>\n</tr>\n<tr style=\"height: 14px;\">\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>ვიდეო შეკუმშვა&nbsp;</p>\n</td>\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>Ultra 265, H.265, H.264, MJPEG</p>\n</td>\n</tr>\n<tr style=\"height: 14px;\">\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>H.264 code profile&nbsp;</p>\n</td>\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"bottom\" nowrap=\"nowrap\">\n<p>Baseline profile, Main profile, High profile</p>\n</td>\n</tr>\n<tr style=\"height: 14px;\">\n<td style=\"width: 358px; background: #f2f2f2; padding: 0cm 5.4pt; height: 14px;\" valign=\"botto